# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env.local y completa los valores.
#  .env.local NO se sube al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Correo saliente ──────────────────────────────────────────
# Opción A (recomendada): SMTP con Gmail.
#   1. Activa la verificación en dos pasos de la cuenta Gmail.
#   2. Crea una "contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords
#   3. Pégala en SMTP_PASS (16 letras, sin espacios).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=construccionespyespa@gmail.com
SMTP_PASS=

# Opción B: API key de Resend — https://resend.com/api-keys
# (solo se usa si no hay SMTP configurado)
RESEND_API_KEY=

# Sin SMTP ni Resend el formulario de contacto NO enviará correos:
# mostrará un aviso y ofrecerá WhatsApp como alternativa.

# Correo que recibe las solicitudes de cotización.
# Si se deja vacío, se usa el definido en src/backend/config/site.ts
CONTACT_TO_EMAIL=

# Remitente. Debe ser un dominio verificado en Resend.
# Para pruebas se puede usar: Sitio web <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# ── Panel de administración ──────────────────────────────────

# Ruta del archivo SQLite con los datos del panel.
# (También va en el archivo .env para que la use Prisma CLI.)
DATABASE_URL="file:./prisma/data.db"

# Secreto que firma las sesiones del panel. OBLIGATORIO en producción.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
