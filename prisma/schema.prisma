// Esquema de la base de datos del panel de administración.
// Tras editarlo: npx prisma migrate dev --name <nombre-del-cambio>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Usuarios con acceso al panel (/admin).
/// Se crean con: npm run admin:crear
model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Clientes de la constructora.
model Client {
  id        String   @id @default(cuid())
  name      String
  rut       String?
  company   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  works     Work[]
  budgets   Budget[]
}

/// Trabajos/obras asociados a un cliente.
model Work {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  status      String     @default("en_progreso") // en_progreso | entregado
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deliveries  Delivery[]
}

/// Representantes de la empresa que firman las actas de entrega.
/// Su firma queda guardada para no tener que dibujarla en cada acta.
model Signer {
  id        String   @id @default(cuid())
  name      String
  /// Cargo, por ejemplo "Constructor Civil".
  role      String?
  /// Firma como data URL PNG con fondo transparente.
  signature String
  /// La que viene marcada por defecto al crear un acta.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Obras que se muestran en la sección pública /proyectos.
/// Se administran desde el panel (/admin/proyectos).
model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  location  String
  year      Int
  surface   String
  duration  String
  client    String
  summary   String
  /// Alcance de la obra: arreglo JSON de strings (un hito por línea).
  scopeJson String   @default("[]")
  /// Foto subida desde el panel; si existe, manda sobre imagePath.
  imageData Bytes?
  imageMime String?
  /// Ruta estática en /public (imágenes de ejemplo iniciales).
  imagePath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Solicitudes de cotización recibidas desde el formulario del sitio.
/// Se guardan SIEMPRE (aunque el correo falle) para que no se pierdan.
model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  location  String?
  message   String
  status    String   @default("nueva") // nueva | contactada | cerrada
  createdAt DateTime @default(now())
}

/// Presupuestos de obra emitidos desde el panel.
/// Los datos del cliente quedan copiados tal como se imprimen:
/// pueden venir de un cliente registrado o escribirse libres.
model Budget {
  id           String   @id @default(cuid())
  folio        Int      @unique
  /// Fecha de emisión que aparece en el documento.
  date         DateTime @default(now())
  /// Validez de la oferta en días corridos.
  validityDays Int      @default(30)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String?
  clientRut    String?
  clientPhone  String?
  clientEmail  String?
  /// Dirección de la obra (calle y número).
  workAddress  String?
  /// Ubicación dentro del recinto (piso, oficina, sector…).
  workPlace    String?
  /// Título de la obra: "HABILITACIÓN Y MODIFICACIÓN DE …".
  workTitle    String
  /// Partidas: JSON [{descripcion, unidad, cantidad, precio}]
  itemsJson    String
  /// Condiciones comerciales: una por línea, se numeran al imprimir.
  conditions   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Actas de entrega conforme (de trabajo o de materiales),
/// firmadas en pantalla por ambas partes.
model Delivery {
  id                String    @id @default(cuid())
  folio             Int       @unique
  workId            String
  work              Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  type              String // trabajo | materiales
  date              DateTime  @default(now())
  notes             String?
  /// Solo entregas de materiales: JSON [{descripcion, cantidad, unidad}]
  itemsJson         String?
  companySignerName String
  clientSignerName  String
  clientSignerRut   String?
  /// Firmas dibujadas en pantalla, como imagen PNG (data URL)
  companySignature  String
  clientSignature   String
  receivedOk        Boolean   @default(true)
  emailSentAt       DateTime?
  createdAt         DateTime  @default(now())
}
