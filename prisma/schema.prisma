// Esquema de la base de datos del panel de administración.
// Tras editarlo: npx prisma migrate dev --name <nombre-del-cambio>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Usuarios con acceso al panel (/admin).
/// Se crean con: npm run admin:crear
model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Clientes de la constructora.
model Client {
  id        String   @id @default(cuid())
  name      String
  rut       String?
  company   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  works     Work[]
  budgets   Budget[]
}

/// Trabajos/obras asociados a un cliente.
model Work {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  status      String     @default("en_progreso") // en_progreso | entregado
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deliveries  Delivery[]
  employees   Employee[]
  payslips    Payslip[]
  dayPayments DayPayment[]
  movements   Movement[]
}

/// Representantes de la empresa que firman las actas de entrega.
/// Su firma queda guardada para no tener que dibujarla en cada acta.
model Signer {
  id        String   @id @default(cuid())
  name      String
  /// Cargo, por ejemplo "Constructor Civil".
  role      String?
  /// Firma como data URL PNG con fondo transparente.
  signature String
  /// La que viene marcada por defecto al crear un acta.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Obras que se muestran en la sección pública /proyectos.
/// Se administran desde el panel (/admin/proyectos).
model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  location  String
  year      Int
  surface   String
  duration  String
  client    String
  summary   String
  /// Alcance de la obra: arreglo JSON de strings (un hito por línea).
  scopeJson String   @default("[]")
  /// Foto subida desde el panel; si existe, manda sobre imagePath.
  imageData Bytes?
  imageMime String?
  /// Ruta estática en /public (imágenes de ejemplo iniciales).
  imagePath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Solicitudes de cotización recibidas desde el formulario del sitio.
/// Se guardan SIEMPRE (aunque el correo falle) para que no se pierdan.
model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  location  String?
  message   String
  status    String   @default("nueva") // nueva | contactada | cerrada
  createdAt DateTime @default(now())
}

/// Presupuestos de obra emitidos desde el panel.
/// Los datos del cliente quedan copiados tal como se imprimen:
/// pueden venir de un cliente registrado o escribirse libres.
model Budget {
  id           String   @id @default(cuid())
  folio        Int      @unique
  /// Fecha de emisión que aparece en el documento.
  date         DateTime @default(now())
  /// Validez de la oferta en días corridos.
  validityDays Int      @default(30)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String?
  clientRut    String?
  clientPhone  String?
  clientEmail  String?
  /// Dirección de la obra (calle y número).
  workAddress  String?
  /// Ubicación dentro del recinto (piso, oficina, sector…).
  workPlace    String?
  /// Título de la obra: "HABILITACIÓN Y MODIFICACIÓN DE …".
  workTitle    String
  /// Partidas: JSON [{descripcion, unidad, cantidad, precio}]
  itemsJson    String
  /// Condiciones comerciales: una por línea, se numeran al imprimir.
  conditions   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Actas de entrega conforme (de trabajo o de materiales),
/// firmadas en pantalla por ambas partes.
model Delivery {
  id                String    @id @default(cuid())
  folio             Int       @unique
  workId            String
  work              Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  type              String // trabajo | materiales
  date              DateTime  @default(now())
  notes             String?
  /// Solo entregas de materiales: JSON [{descripcion, cantidad, unidad}]
  itemsJson         String?
  companySignerName String
  clientSignerName  String
  clientSignerRut   String?
  /// Firmas dibujadas en pantalla, como imagen PNG (data URL)
  companySignature  String
  clientSignature   String
  receivedOk        Boolean   @default(true)
  emailSentAt       DateTime?
  createdAt         DateTime  @default(now())
}

/* ── Personal y remuneraciones ─────────────────────────────── */

/// Trabajadores de la empresa (con contrato o pagados por día).
model Employee {
  id                 String       @id @default(cuid())
  rut                String       @unique
  name               String
  birthDate          DateTime?
  nationality        String?
  address            String?
  phone              String?
  email              String?
  /// Cargo: "Maestro carpintero", "Jornal", …
  position           String
  /// plazo_fijo | obra_faena | indefinido | dia_hombre
  contractType       String
  startDate          DateTime
  /// Término pactado (plazo fijo) o estimado (obra).
  contractEndDate    DateTime?
  /// activo | desvinculado
  status             String       @default("activo")
  terminationDate    DateTime?
  /// Sueldo base mensual (contratos con liquidación).
  baseSalary         Int          @default(0)
  /// Valor del día (día hombre).
  dailyRate          Int          @default(0)
  /// Jornada semanal pactada en horas.
  weeklyHours        Int          @default(42)
  /// Paga gratificación legal mensual (art. 50).
  gratification      Boolean      @default(true)
  /// capital | cuprum | habitat | modelo | planvital | provida | uno
  afp                String?
  /// fonasa | isapre
  healthSystem       String       @default("fonasa")
  isapreName         String?
  /// Plan de Isapre pactado, en UF.
  isapreUf           Float?
  /// Colación y movilización mensuales (no imponibles).
  mealAllowance      Int          @default(0)
  transportAllowance Int          @default(0)
  bankName           String?
  accountType        String?
  accountNumber      String?
  /// Obra donde trabaja actualmente.
  workId             String?
  work               Work?        @relation(fields: [workId], references: [id], onDelete: SetNull)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  payslips           Payslip[]
  settlements        Settlement[]
  dayPayments        DayPayment[]
}

/// Indicadores previsionales de un mes (UF, UTM, topes, tasas).
/// Se cargan desde Previred antes de emitir las liquidaciones del mes.
model PayrollParams {
  id                  String   @id @default(cuid())
  /// "2026-11"
  period              String   @unique
  uf                  Float
  utm                 Int
  minWage             Int
  topeAfpUf           Float
  topeAfcUf           Float
  /// JSON { capital: 11.44, … } — % total descontado al trabajador.
  afpRatesJson        String
  sisRate             Float
  mutualRate          Float
  employerPensionRate Float
  /// previred (sincronizado solo) | manual (guardado a mano: no se sobrescribe)
  source              String    @default("manual")
  /// La UF del último día del mes aún no estaba publicada (se usó la anterior).
  ufProvisional       Boolean   @default(false)
  /// Última sincronización automática con Previred.
  syncedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Liquidación de sueldo mensual. Guarda una copia del cálculo y de los
/// datos del trabajador para que el documento no cambie después.
model Payslip {
  id          String    @id @default(cuid())
  folio       Int       @unique
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "2026-11"
  period      String
  /// Obra a la que se carga el costo.
  workId      String?
  work        Work?     @relation(fields: [workId], references: [id], onDelete: SetNull)
  inputJson   String
  /// Cálculo + datos del trabajador y parámetros usados (snapshot).
  resultJson  String
  netPay      Int
  companyCost Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  movement    Movement?

  @@unique([employeeId, period])
}

/// Finiquito: término de la relación laboral.
model Settlement {
  id         String    @id @default(cuid())
  folio      Int       @unique
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  endDate    DateTime
  /// Causal: 159-1 | 159-2 | 159-4 | 159-5 | 160 | 161-1
  cause      String
  inputJson  String
  resultJson String
  total      Int
  createdAt  DateTime  @default(now())
  movement   Movement?
}

/// Pago a un trabajador por días trabajados (día hombre).
model DayPayment {
  id         String    @id @default(cuid())
  folio      Int       @unique
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workId     String?
  work       Work?     @relation(fields: [workId], references: [id], onDelete: SetNull)
  /// Fecha de pago.
  date       DateTime
  /// Periodo trabajado, texto libre: "3 al 7 de noviembre".
  periodText String?
  days       Float
  dailyRate  Int
  extras     Int       @default(0)
  discounts  Int       @default(0)
  total      Int
  notes      String?
  createdAt  DateTime  @default(now())
  movement   Movement?
}

/* ── Finanzas ─────────────────────────────────────────────── */

/// Ingresos y gastos de la empresa. Los que nacen de una liquidación,
/// un finiquito o un pago de día hombre se crean y borran solos.
model Movement {
  id              String      @id @default(cuid())
  /// ingreso | gasto
  type            String
  date            DateTime
  /// Monto total en pesos.
  amount          Int
  category        String
  description     String
  workId          String?
  work            Work?       @relation(fields: [workId], references: [id], onDelete: SetNull)
  /// factura | boleta | boleta_honorarios | guia | comprobante | otro
  docType         String?
  docNumber       String?
  /// Proveedor (gasto) o cliente (ingreso).
  counterparty    String?
  counterpartyRut String?
  /// efectivo | transferencia | cheque | tarjeta
  paymentMethod   String?
  notes           String?
  /// Respaldo: foto o PDF del documento.
  attachmentData  Bytes?
  attachmentMime  String?
  attachmentName  String?
  payslipId       String?     @unique
  payslip         Payslip?    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  settlementId    String?     @unique
  settlement      Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  dayPaymentId    String?     @unique
  dayPayment      DayPayment? @relation(fields: [dayPaymentId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([date])
}
